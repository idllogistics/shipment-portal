generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum CheckpointType {
  PICKUP
  DELIVERY
}

enum ItemCondition {
  GOOD
  DAMAGED
}

enum ApproverRole {
  SENDER
  RECEIVER
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum CancelledBy {
  CUSTOMER
  ADMIN
}

model Shipment {
  id             String         @id @default(cuid())
  trackingNumber String         @unique
  customerName   String
  customerEmail  String?
  origin         String?
  destination    String?
  status         ShipmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  photos         Photo[]
  events         Event[]
  checkpoints    Checkpoint[]
  documents      ShipmentDocument[]
  driverId       String?
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)

  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderRequest   OrderRequest?

  cancelReason   String?
  cancelledBy    CancelledBy?
  cancelledAt    DateTime?

  // Filled in manually or auto-extracted from an uploaded invoice/packing
  // list (see ShipmentDocument). Editable afterward in case OCR gets
  // something wrong.
  itemDescription        String?
  itemQuantity           String?
  declaredValue          Float?
  declaredValueCurrency  String?  @default("AED")
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  shipments      Shipment[]
  orderRequests  OrderRequest[]
  passwordResetRequests PasswordResetRequest[]
  passwordResetTokens   PasswordResetToken[]
}

model OrderRequest {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  origin          String
  destination     String
  itemDescription String?
  itemQuantity    String?
  notes           String?
  status          OrderRequestStatus @default(PENDING)
  declineReason   String?
  cancelReason    String?
  shipmentId      String?            @unique
  shipment        Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
}

model Driver {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  accessCode     String    @unique
  active         Boolean   @default(true)
  lastLat        Float?
  lastLng        Float?
  lastAccuracy   Float?
  lastLocationAt DateTime?
  createdAt      DateTime  @default(now())
  shipments      Shipment[]
}

model Photo {
  id           String      @id @default(cuid())
  shipmentId   String
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  checkpointId String?
  checkpoint   Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  url          String
  caption      String?
  createdAt    DateTime    @default(now())
}

model Checkpoint {
  id             String         @id @default(cuid())
  shipmentId     String
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type           CheckpointType
  condition      ItemCondition
  conditionNotes String?
  approverName   String
  approverRole   ApproverRole
  signatureUrl   String
  photos         Photo[]
  createdAt      DateTime       @default(now())
}

model ShipmentDocument {
  id               String   @id @default(cuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  url              String
  filename         String
  // What OCR extracted from this specific document, kept for provenance
  // even if the shipment's fields get edited afterward.
  itemDescription  String?
  itemQuantity     String?
  declaredValue    Float?
  declaredValueCurrency String?
  extractionError  String?
  createdAt        DateTime @default(now())
}

model Event {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  message    String?
  createdAt  DateTime @default(now())
}

// A customer clicked "forgot password" — a signal for staff to issue a link.
model PasswordResetRequest {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// One-time reset link issued by staff. Only the hash of the token is stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}
